{
  "name": "assay-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Assay Insights portal (BUILD_SPEC.md section 11)",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
