# Default: let Git normalise text files
* text=auto

# Always LF: anything that runs inside a Linux container or is Python
*.py            text eol=lf
*.pyi           text eol=lf
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerfile    text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
uv.lock         text eol=lf
.python-version text eol=lf
# Markdown too: tests/isolation/README.md goes into the isolation image, and an image's tag is
# the hash of its sources' bytes on disk, which must not depend on a machine's core.autocrlf.
*.md            text eol=lf
.editorconfig   text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary
*.pdf  binary
*.mako        text eol=lf
*.ini         text eol=lf
